<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ödeme Sayfası</title>
    <!-- CSS dosyasını bağla -->
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <div class="container">
        <h1>Ödeme Sayfası</h1>
        <p class="price">Toplam Tutar: 8.000 TL</p>

        <div class="payment-info">
            <label for="name">Adınız ve Soyadınız</label>
            <input type="text" id="name" placeholder="Adınızı ve soyadınızı girin">

            <label for="card-number">Kart Numarası</label>
            <input type="text" id="card-number" placeholder="Kart numaranızı girin">

            <label for="expiry-date">Son Kullanma Tarihi</label>
            <input type="text" id="expiry-date" placeholder="MM/YY">

            <label for="cvv">CVV</label>
            <input type="text" id="cvv" placeholder="CVV numaranızı girin">

            <button class="btn" type="submit">Ödeme Yap</button>
        </div>

        <div class="footer">
            <p>Bu ödeme sayfası örnek amaçlıdır ve gerçek işlem yapılmaz.</p>
        </div>
    </div>

</body>
</html>








